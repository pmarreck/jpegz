#!/usr/bin/env bash
# Build and run sandboxed ReleaseSafe fuzz checks through Nix.
set -u
root=$(cd -- "$(dirname -- "$0")" && pwd) || exit 1
campaign=0
rebuild=()
for argument in "$@"; do
	case $argument in
		--fuzz) campaign=1 ;;
		--rebuild) rebuild=(--rebuild) ;;
		-h|--help)
			cat <<'EOF'
usage: ./fuzz [--fuzz] [--rebuild]

Default: replay the fixed seed corpus in a Nix ReleaseSafe check.
--fuzz: run the bounded campaign requesting 10000 iterations per harness
        with seed 0x6a706567; the runner can overshoot within a batch.
--rebuild: request fresh execution of an already prepared Nix check.

Nix can reuse a previous check result without --rebuild. Custom compiler
arguments and duration suffixes are unsupported by this wrapper. Both modes
compile and execute inside the Nix build sandbox; no host compiler is used.
EOF
			exit 0 ;;
		*) printf 'fuzz: unsupported argument: %s; use --help\n' "$argument" >&2; exit 2 ;;
	esac
done
if [[ ${FUZZ_OPT:-ReleaseSafe} != ReleaseSafe ]]; then
	printf 'fuzz: only the qualified ReleaseSafe profile is supported\n' >&2
	exit 2
fi
system=$(nix eval --impure --raw --expr builtins.currentSystem) || exit "$?"
target=checks.$system.fuzz-seeds
if [[ $campaign -eq 1 ]]; then target=packages.$system.fuzz-campaign; fi
exec nix build "$root#$target" --no-link --print-build-logs "${rebuild[@]}"
