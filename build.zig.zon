.{
    .name = .jpegz,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "deps",
        "include",
        "tests",
        "LICENSE",
        "README.md",
    },
    .fingerprint = 0xaaef54e4e0b0d6b2,
    .dependencies = .{
        // Lazy: only the cross-compile path (vendored static openjp2, no
        // system -Dopenjpeg-lib) links this and triggers its fetch. A
        // non-lazy dep would be fetched eagerly at manifest resolution even
        // on the native system-openjpeg path, breaking the sandboxed Linux
        // build (no network). Pairs with b.lazyDependency in build.zig.
        .openjpeg = .{ .path = "deps/openjpeg", .lazy = true },
        .jp2z = .{
            .url = "https://github.com/pmarreck/jp2z/archive/77dbeaa9686275282b01315f2c19f658c8770515.tar.gz",
            .hash = "jp2z-0.0.1-yLLHxVA2bgAw5WGQdx-2dxSPLyAOQjDw03jxJOAbsEzV",
        },
        .libjxlz = .{
            // Private: Nix seeds this package from its locked SSH input.
            .url = "https://github.com/pmarreck/libjxlz/archive/93b29e86281ea4ba9c681f4879318c87e8a800a4.tar.gz",
            .hash = "libjxlz-0.1.0-H-8wmybdlgGIAgb2uW_qaia2B-pT2b3JqHev4t6f_6Bb",
        },
    },
}
