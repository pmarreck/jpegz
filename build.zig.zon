.{
    .name = .jpegz,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "deps",
        "include",
        "tests",
        "LICENSE",
        "README.md",
    },
    .fingerprint = 0xaaef54e4e0b0d6b2,
    .dependencies = .{
        // Lazy: only the cross-compile path (vendored static openjp2, no
        // system -Dopenjpeg-lib) links this and triggers its fetch. A
        // non-lazy dep would be fetched eagerly at manifest resolution even
        // on the native system-openjpeg path, breaking the sandboxed Linux
        // build (no network). Pairs with b.lazyDependency in build.zig.
        .openjpeg = .{ .path = "deps/openjpeg", .lazy = true },
        .jp2z = .{
            .url = "https://github.com/pmarreck/jp2z/archive/d3754cfcfe3980daecb90de12d82ef4bdf100ce6.tar.gz",
            .hash = "jp2z-0.0.1-yLLHxfSIQQDp9paH7zDaiSHmZePKAmEpBxwvrn9Df6cp",
        },
        .libjxlz = .{
            .url = "https://github.com/pmarreck/libjxlz/archive/5e8f9d68152ae8a70cb823061f4b6c733eb09166.tar.gz",
            .hash = "libjxlz-0.1.0-H-8wm8uGFwCaw6ZEz37LxZX_7_UMPqRBcUWQrnQ-ONRq",
        },
    },
}
