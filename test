#!/usr/bin/env bash
# Run the full jpegz test suite via nix flake check (sandboxed).
#
# Per CLAUDE.md "Testing Principles": never use `set -euo pipefail` here —
# `set -e` aborts on the first non-zero exit code, which silently masks
# additional sub-suite failures. Instead, accumulate exit codes explicitly.

set -u

cd "$(dirname "$0")"

failures=0

run_check() {
	local name="$1"
	shift
	echo
	echo "==> $name"
	if "$@"; then
		echo "    ok"
	else
		echo "    FAIL ($name)"
		failures=$((failures + 1))
	fi
}

run_check "dev shell package metadata" \
	nix eval --raw .#devShells."$(nix eval --impure --raw --expr 'builtins.currentSystem')".default \
	--apply 'shell: builtins.deepSeq (map (p: p.meta.changelog or null) shell.nativeBuildInputs) "Package metadata evaluated.\n"'

run_check "codec source compatibility controls" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".dependency-compatibility --no-link --print-build-logs

run_check "zig unit tests (nix flake check .#test)" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".test --print-build-logs

coverage_stats_artifact() {
	local artifact
	artifact=$(nix build .#coverage-stats --no-link --print-out-paths) || return 1
	[[ -f $artifact/bin/jpegz-coverage-stats && -x $artifact/bin/jpegz-coverage-stats ]]
}
run_check "coverage statistics Nix artifact" coverage_stats_artifact

run_check "package builds (nix flake check .#build)" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".build --print-build-logs

run_check "Windows cross-link check" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".cross-windows --print-build-logs

for platform in aarch64-linux aarch64-macos aarch64-windows; do
	run_check "$platform cross-link check" \
		nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')"."cross-$platform" --print-build-logs
done

run_check "validator dependency closure" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".validator-closure --print-build-logs

# Consumer-facing invariant that jpegz's own build CANNOT catch: every jpegz
# test links the C libs, so a regression that re-forces libjpeg/openjpeg/charls
# onto pure-Zig importers is silent in-tree. This compiles a validate-only
# consumer out-of-graph with C deliberately withheld in a Nix sandbox. Carries
# its own negative control, so it cannot pass vacuously.
run_check "zero-C-dependency Zig consumer" \
	nix build .#checks."$(nix eval --impure --raw --expr 'builtins.currentSystem')".no-c-consumer --no-link --print-build-logs

echo
if [ "$failures" -eq 0 ]; then
	echo "All checks passed."
	exit 0
else
	echo "$failures check(s) failed."
	exit 1
fi
