#!/usr/bin/env bash
# Reject recorded fuzz failures even when the pinned driver exits successfully.
# With SEED, every failure also names the seed and reproduction command and,
# when the driver saved one, prints the crash input in base64.
set -u
if [[ $# -lt 3 || $# -gt 4 ]]; then
	printf 'usage: check-fuzz-result STATUS CACHE_DIR DRIVER_LOG [SEED]\n' >&2
	exit 2
fi
if [[ $# -eq 4 && ! $4 =~ ^0x[0-9a-f]{8}$ ]]; then
	printf 'fuzz-check: seed must be 0x followed by 8 lowercase hex digits\n' >&2
	exit 2
fi
cache=$2
log=$3
seed=${4-}
crash_limit=65536

classify() {
	case $1 in
		0) ;;
		[1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) return "$1" ;;
		*) printf 'fuzz-check: invalid driver status\n' >&2; return 2 ;;
	esac
	if [[ ! -d $cache || ! -f $log || ! -r $log ]]; then
		printf 'fuzz-check: required driver evidence is unavailable\n' >&2
		return 1
	fi
	if [[ -e $cache/f/crash || -L $cache/f/crash ]]; then
		printf 'fuzz-check: crash input was recorded\n' >&2
		return 1
	fi
	# Match the pinned driver's error records, including its existing SGR colors.
	# The caller also disables color; the older recorded witness still must fail.
	local diagnostic=$'^(\033\\[[0-9;]*m)*(error:|failed command:)' line
	while IFS= read -r line || [[ -n $line ]]; do
		if [[ $line =~ $diagnostic ]]; then
			printf 'fuzz-check: driver reported a failed step\n' >&2
			return 1
		fi
	done < "$log"
	return 0
}

classify "$1"
status=$?
if [[ $status -ne 0 && -n $seed ]]; then
	printf 'fuzz-check: failed with seed %s; reproduce with: ./fuzz --fuzz --seed %s\n' "$seed" "$seed" >&2
	crash=$cache/f/crash
	if [[ -f $crash && ! -L $crash && -r $crash ]]; then
		bytes=$(wc -c < "$crash")
		bytes=${bytes//[[:space:]]/}
		if [[ $bytes -le $crash_limit ]]; then
			printf 'fuzz-check: crash input, %s bytes (Smith length-prefixed), base64:\n' "$bytes" >&2
			base64 < "$crash" >&2
			printf 'fuzz-check: end of crash input\n' >&2
		else
			printf 'fuzz-check: crash input is %s bytes, over the %s-byte print limit; rerun the seed with --keep-failed\n' "$bytes" "$crash_limit" >&2
		fi
	fi
fi
exit "$status"
